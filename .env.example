DATABASE_URL="sqlite:///./alquilometro.db"
SQL_ECHO=False
# Para usar PostgreSQL local, reemplazá DATABASE_URL y elegí otra carpeta de fotos:
# DATABASE_URL=postgresql+psycopg://alquilometro:TU_CLAVE@127.0.0.1:5432/alquilometro
# CARPETA_FOTOS=fotos-postgres
# Activar después de revisar los archivos huérfanos detectados en el log.
FOTOS_ELIMINAR_HUERFANAS=false
# Autenticacion (JWT). Clave largo y random en produccion
JWT_SECRET_KEY=cambiar-esta-clave 
JWT_MINUTOS_EXPIRACION=60

# Planes manuales para inmobiliarias (importes en pesos argentinos).
PLANES_MODO_PRUEBA=true
PLANES_ABONO_MENSUAL_ARS=15000
PLANES_PATROCINIO_ARS=5000
# Links de pago de importe fijo. Mantener modo prueba hasta definir los precios.
# PLANES_ABONO_MERCADO_PAGO_URL=https://mpago.la/...
# PLANES_PATROCINIO_MERCADO_PAGO_URL=https://mpago.la/...
PLANES_TRANSFERENCIA_TITULAR=
PLANES_TRANSFERENCIA_ALIAS=
PLANES_TRANSFERENCIA_CVU=

# Avisos de abono. Configurar un servidor SMTP con TLS en el puerto 465.
AVISOS_SMTP_HOST=
AVISOS_SMTP_USUARIO=
AVISOS_SMTP_CLAVE=
AVISOS_EMAIL_DESDE=
# AVISOS_URL_PUBLICA=https://alquilometro.example.com/
